#!/usr/bin/env python3
"""Small local bridge between the Omarchy widget and SABnzbd's HTTP API."""

from __future__ import annotations

import argparse
import configparser
import json
import math
import ssl
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any


DEFAULT_CONFIGS = (
    Path.home() / ".sabnzbd" / "sabnzbd.ini",
    Path.home() / ".config" / "sabnzbd" / "sabnzbd.ini",
)
MAX_API_RESPONSE_BYTES = 1024 * 1024
MAX_CONFIG_BYTES = 1024 * 1024
MAX_OUTPUT_BYTES = 2 * 1024 * 1024
MAX_PROCESSING_JOBS = 1000
MAX_TOTAL_COUNT = 1_000_000
MAX_JOB_ID_CHARS = 256
MAX_NAME_CHARS = 512
MAX_FAILURE_CHARS = 2048
MAX_LABELS = 16
MAX_LABEL_CHARS = 128
MAX_SHORT_TEXT_CHARS = 128
MAX_STORAGE_CHARS = 512
MAX_DISK_THRESHOLD_GB = 100000.0
DEFAULT_DISK_THRESHOLD_GB = 20.0


class ApiResponseError(Exception):
    """Raised when the local SABnzbd API returns unsafe or invalid data."""


class NoRedirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(
        self,
        request: Any,
        file_pointer: Any,
        code: int,
        message: str,
        headers: Any,
        new_url: str,
    ) -> None:
        return None


def reject_json_constant(value: str) -> None:
    raise ApiResponseError(f"Invalid JSON number: {value}")


def emit(payload: dict[str, Any], code: int = 0) -> None:
    try:
        output = json.dumps(payload, separators=(",", ":"), allow_nan=False)
    except (TypeError, ValueError):
        output = '{"ok":false,"state":"api-error","message":"Could not serialize SABnzbd response"}'
        code = 5
    if len(output.encode("utf-8")) > MAX_OUTPUT_BYTES:
        output = '{"ok":false,"state":"api-error","message":"SABnzbd response exceeded the safe output limit"}'
        code = 5
    print(output)
    raise SystemExit(code)


def find_config(explicit: str) -> Path:
    if explicit:
        path = Path(explicit).expanduser()
        if path.is_file():
            return path
        raise FileNotFoundError(f"SABnzbd config not found: {path}")
    for path in DEFAULT_CONFIGS:
        if path.is_file():
            return path
    raise FileNotFoundError("Start SABnzbd once to create ~/.sabnzbd/sabnzbd.ini")


def ini_text(value: str) -> str:
    """Normalize SABnzbd INI strings, which often quote empty values as \"\"."""
    result = value.strip()
    if len(result) >= 2 and result[0] == result[-1] and result[0] in "\"'":
        result = result[1:-1].strip()
    return result


def connection(path: Path) -> tuple[str, str]:
    config = configparser.ConfigParser(interpolation=None)
    with path.open("rb") as config_file:
        raw_contents = config_file.read(MAX_CONFIG_BYTES + 1)
    if len(raw_contents) > MAX_CONFIG_BYTES:
        raise ValueError("SABnzbd config exceeds the 1 MiB safety limit")
    contents = raw_contents.decode("utf-8")
    # SABnzbd keeps format metadata before its first INI section.
    config.read_string("[sabnzbd_metadata]\n" + contents)
    misc = config["misc"]
    port = misc.getint("port", fallback=8080)
    if not 1 <= port <= 65535:
        raise ValueError("SABnzbd port must be between 1 and 65535")
    scheme = "https" if misc.getboolean("enable_https", fallback=False) else "http"
    api_key = ini_text(misc.get("api_key", fallback=""))
    if not api_key:
        raise ValueError("SABnzbd API key is missing; check Config > General")
    if len(api_key) > 256:
        raise ValueError("SABnzbd API key exceeds the safety limit")
    url_base = ini_text(misc.get("url_base", fallback="")).strip("/")
    if len(url_base) > 256:
        raise ValueError("SABnzbd URL base exceeds the safety limit")
    base_url = f"{scheme}://127.0.0.1:{port}"
    if url_base:
        base_url += f"/{url_base}"
    return base_url, api_key


def api(base_url: str, api_key: str, **params: Any) -> dict[str, Any]:
    query = {"output": "json", "apikey": api_key}
    query.update({key: str(value) for key, value in params.items()})
    url = f"{base_url}/api?{urllib.parse.urlencode(query)}"
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    context = ssl._create_unverified_context() if base_url.startswith("https://127.0.0.1:") else None
    handlers: list[Any] = [urllib.request.ProxyHandler({}), NoRedirects()]
    if context is not None:
        handlers.append(urllib.request.HTTPSHandler(context=context))
    opener = urllib.request.build_opener(*handlers)
    with opener.open(request, timeout=3) as response:
        content_length = response.headers.get("Content-Length")
        announced_length = None
        if content_length:
            try:
                announced_length = int(content_length)
                if announced_length < 0:
                    raise ValueError
                if announced_length > MAX_API_RESPONSE_BYTES:
                    raise ApiResponseError("SABnzbd API response exceeds the 1 MiB safety limit")
            except ValueError as error:
                raise ApiResponseError("SABnzbd API returned an invalid Content-Length") from error
        body = response.read(MAX_API_RESPONSE_BYTES + 1)
    if len(body) > MAX_API_RESPONSE_BYTES:
        raise ApiResponseError("SABnzbd API response exceeds the 1 MiB safety limit")
    if announced_length is not None and len(body) != announced_length:
        raise ApiResponseError("SABnzbd API returned an incomplete response")
    try:
        payload = json.loads(body, parse_constant=reject_json_constant)
    except (json.JSONDecodeError, UnicodeDecodeError, RecursionError, ValueError) as error:
        raise ApiResponseError("SABnzbd API returned invalid JSON") from error
    if not isinstance(payload, dict):
        raise ApiResponseError("SABnzbd API response must be a JSON object")
    return payload


def text(value: Any, default: str = "", limit: int = MAX_SHORT_TEXT_CHARS) -> str:
    if value is None:
        result = default
    elif isinstance(value, (str, int, float, bool)):
        try:
            result = str(value)
        except ValueError:
            result = default
    else:
        result = default
    return result[:limit]


def number(value: Any, default: float = 0.0) -> float:
    try:
        result = float(value)
    except (TypeError, ValueError, OverflowError):
        return default
    return result if math.isfinite(result) else default


def count(value: Any, default: int) -> int:
    return max(0, min(MAX_TOTAL_COUNT, int(number(value, float(default)))))


def section(payload: dict[str, Any], name: str) -> dict[str, Any]:
    value = payload.get(name, {})
    return value if isinstance(value, dict) else {}


def slots(payload: dict[str, Any], limit: int) -> list[dict[str, Any]]:
    value = payload.get("slots", [])
    if not isinstance(value, list):
        return []
    return [item for item in value[:limit] if isinstance(item, dict)]


def labels(value: Any) -> list[str]:
    if not isinstance(value, list):
        return []
    return [text(item, limit=MAX_LABEL_CHARS) for item in value[:MAX_LABELS]]


def job_id(value: str) -> str:
    if not value:
        raise ValueError("Job action requires a SABnzbd job id")
    if len(value) > MAX_JOB_ID_CHARS or any(ord(character) < 32 for character in value):
        raise ValueError("SABnzbd job id exceeds the safety limit")
    return value


def succeeded(payload: dict[str, Any]) -> bool:
    return payload.get("status") is True


def boolean(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in {"1", "true", "yes", "on"}
    return False


def disk_threshold(value: Any) -> float:
    return max(0.0, min(MAX_DISK_THRESHOLD_GB, number(value, DEFAULT_DISK_THRESHOLD_GB)))


def storage_path(value: Any) -> str:
    result = text(value, limit=MAX_STORAGE_CHARS)
    if not result.startswith("/") or any(ord(character) < 32 for character in result):
        return ""
    return result


def progress(slot: dict[str, Any]) -> float:
    if "percentage" in slot:
        return max(0.0, min(100.0, number(slot.get("percentage"))))
    total = number(slot.get("mb"))
    left = number(slot.get("mbleft"))
    return max(0.0, min(100.0, (1.0 - left / total) * 100.0)) if total > 0 else 0.0


def job(slot: dict[str, Any], *, done: bool = False) -> dict[str, Any]:
    status = text(slot.get("status"), "Unknown") or "Unknown"
    name = text(slot.get("name"), limit=MAX_NAME_CHARS) or text(
        slot.get("filename"), "Untitled", MAX_NAME_CHARS
    )
    return {
        "id": text(slot.get("nzo_id"), limit=MAX_JOB_ID_CHARS),
        "name": name or "Untitled",
        "status": status,
        "progress": 100.0 if status == "Completed" else round(progress(slot), 2),
        "category": text(slot.get("cat")) or text(slot.get("category")),
        "size": text(slot.get("size")),
        "sizeleft": text(slot.get("sizeleft")),
        "timeleft": text(slot.get("timeleft")),
        "completed": text(slot.get("completed_nice")),
        "failure": text(slot.get("fail_message"), limit=MAX_FAILURE_CHARS)
        or text(slot.get("script_line"), limit=MAX_FAILURE_CHARS),
        "labels": labels(slot.get("labels")),
        "priority": text(slot.get("priority")),
        "retry_count": count(slot.get("retry"), 0),
        "storage": storage_path(slot.get("storage")),
        "done": done,
        "failed": status == "Failed",
    }


def snapshot(
    base_url: str,
    api_key: str,
    queue_limit: int,
    history_limit: int,
    disk_threshold_gb: float = DEFAULT_DISK_THRESHOLD_GB,
) -> dict[str, Any]:
    queue_data = section(api(base_url, api_key, mode="queue", start=0, limit=queue_limit), "queue")
    processing_statuses = "QuickCheck,Verifying,Repairing,Fetching,Extracting,Moving,Running,Queued"
    recent_statuses = "Completed,Failed"
    processing_data = section(
        api(base_url, api_key, mode="history", start=0, limit=MAX_PROCESSING_JOBS, status=processing_statuses),
        "history",
    )
    history_data = section(
        api(base_url, api_key, mode="history", start=0, limit=history_limit, status=recent_statuses),
        "history",
    )
    queue_jobs = [job(slot) for slot in slots(queue_data, queue_limit)]
    processing_jobs = [job(slot) for slot in slots(processing_data, MAX_PROCESSING_JOBS)]
    history_jobs = [
        job(slot, done=text(slot.get("status"), "Unknown") in {"Completed", "Failed"})
        for slot in slots(history_data, history_limit)
    ]

    verify_statuses = {"QuickCheck", "Verifying", "Repairing", "Fetching"}
    unpack_statuses = {"Extracting", "Moving", "Running", "Queued"}
    verify = [item for item in processing_jobs if item["status"] in verify_statuses]
    unpack = [item for item in processing_jobs if item["status"] in unpack_statuses]
    recent = [item for item in history_jobs if item["status"] in {"Completed", "Failed"}]
    failed = [item for item in history_jobs if item["status"] == "Failed"]
    completed = [item for item in history_jobs if item["status"] == "Completed"]

    raw_speed = text(queue_data.get("speed"), "0 B").strip() or "0 B"
    if raw_speed.replace(".", "", 1).isdigit():
        raw_speed += " B"
    speed = raw_speed if raw_speed.lower().endswith("/s") else f"{raw_speed}/s"
    disk_values = [number(queue_data.get("diskspace1"), -1), number(queue_data.get("diskspace2"), -1)]
    available_values = [value for value in disk_values if value >= 0]
    disk_free_gb = min(available_values) if available_values else -1

    queue_total = count(queue_data.get("noofslots_total", queue_data.get("noofslots")), len(queue_jobs))
    processing_total = count(processing_data.get("noofslots"), len(processing_jobs))
    history_total = count(history_data.get("noofslots"), len(history_jobs))

    return {
        "ok": True,
        "state": "ready",
        "web_url": base_url,
        "queue": {
            "status": text(queue_data.get("status"), "Idle") or "Idle",
            "paused": boolean(queue_data.get("paused", False)),
            "speed": speed,
            "kbpersec": number(queue_data.get("kbpersec")),
            "timeleft": text(queue_data.get("timeleft"), "0:00:00") or "0:00:00",
            "sizeleft": text(queue_data.get("sizeleft"), "0 B") or "0 B",
            "jobs": queue_jobs,
        },
        "disk": {
            "free_gb": round(disk_free_gb, 1),
            "free": text(queue_data.get("diskspace2_norm"))
            or text(queue_data.get("diskspace1_norm"), "Unknown"),
            "low": 0 <= disk_free_gb < disk_threshold_gb,
        },
        "stages": {
            "download": queue_jobs,
            "verify": verify,
            "unpack": unpack,
            "recent": recent,
        },
        "counts": {
            "download": len(queue_jobs),
            "verify": len(verify),
            "unpack": len(unpack),
            "recent": len(recent),
            "failed": len(failed),
            "completed": len(completed),
            "active_total": queue_total + processing_total,
            "queue_total": queue_total,
            "history_total": history_total,
        },
    }


def demo_snapshot(
    state: str,
    queue_limit: int = 100,
    history_limit: int = 50,
    disk_threshold_gb: float = DEFAULT_DISK_THRESHOLD_GB,
) -> dict[str, Any]:
    if state == "not-configured":
        return {"ok": False, "state": "not-configured", "message": "Start SABnzbd once to create ~/.sabnzbd/sabnzbd.ini"}
    if state == "offline":
        return {"ok": False, "state": "offline", "message": "SABnzbd is not running"}
    jobs = {
        "downloading": [
            {"id": "demo-1", "name": "omarchy-4.0.0.iso", "status": "Downloading", "progress": 63.0, "category": "omarchy", "size": "5.8 GB", "sizeleft": "2.1 GB", "timeleft": "0:03:42", "completed": "", "done": False, "failed": False}
        ],
        "processing": [
            {"id": "demo-2", "name": "omarchy-4.0.0.iso", "status": "Verifying", "progress": 82.0, "category": "omarchy", "size": "5.8 GB", "sizeleft": "", "timeleft": "0:02:11", "completed": "", "done": False, "failed": False},
        ],
        "multiple": [
            {"id": "demo-3", "name": "omarchy-4.0.0.iso", "status": "Downloading", "progress": 41.0, "category": "omarchy", "size": "5.8 GB", "sizeleft": "3.4 GB", "timeleft": "0:06:09", "completed": "", "done": False, "failed": False},
            {"id": "demo-4", "name": "Frankenstein.1910.Library-of-Congress.mp4", "status": "Queued", "progress": 0.0, "category": "public-domain", "size": "248 MB", "sizeleft": "248 MB", "timeleft": "", "completed": "", "done": False, "failed": False},
        ],
        "failed": [],
    }
    if state == "large":
        active = []
        for index in range(275):
            status = "Downloading" if index == 0 else ("Paused" if index % 11 == 0 else "Queued")
            active.append({"id": f"demo-large-{index}", "name": f"Linux.Archive.Collection.Part.{index + 1:03d}.A.Very.Long.Release.Name", "status": status, "progress": 58.0 if index == 0 else 0.0, "category": "archives", "size": "8.4 GB", "sizeleft": "3.5 GB" if index == 0 else "8.4 GB", "timeleft": "0:11:23" if index == 0 else "", "completed": "", "failure": "", "labels": [], "priority": "Normal", "retry_count": 0, "done": False, "failed": False})
    else:
        active = jobs.get(state, jobs["downloading"])
    active_total = len(active)
    if state == "large":
        active = active[:queue_limit]
    download = [item for item in active if item["status"] in {"Downloading", "Queued", "Paused"}]
    verify = [item for item in active if item["status"] in {"Verifying", "Repairing", "QuickCheck"}]
    unpack = [item for item in active if item["status"] in {"Extracting", "Moving", "Running"}]
    recent = [
        {"id": "recent-1", "name": "Frankenstein.1910.Library-of-Congress.mp4", "status": "Completed", "progress": 100.0, "category": "public-domain", "size": "248 MB", "sizeleft": "", "timeleft": "", "completed": "an hour ago", "storage": "/home/user/Downloads/complete/Frankenstein.1910.Library-of-Congress", "done": True, "failed": False},
        {"id": "recent-2", "name": "Nosferatu.1922.Public-Domain.1080p.mp4", "status": "Completed", "progress": 100.0, "category": "public-domain", "size": "1.8 GB", "sizeleft": "", "timeleft": "", "completed": "yesterday", "storage": "/home/user/Downloads/complete/Nosferatu.1922.Public-Domain.1080p", "done": True, "failed": False},
    ]
    if state == "clean":
        recent = []
    if state in {"failed", "large"}:
        recent.insert(0, {"id": "recent-failed", "name": "omarchy-4.0.0.iso", "status": "Failed", "progress": 71.0, "category": "omarchy", "size": "5.8 GB", "sizeleft": "", "timeleft": "", "completed": "12 minutes ago", "failure": "Repair failed, not enough repair blocks (142 short)", "labels": ["INCOMPLETE"], "priority": "Normal", "retry_count": 1, "done": True, "failed": True})
    history_total = len(recent)
    if state == "large":
        for index in range(3, 123):
            failed_item = index % 9 == 0
            recent.append({"id": f"recent-{index}", "name": f"Completed.Archive.Release.{index:03d}", "status": "Failed" if failed_item else "Completed", "progress": 100.0, "category": "archives", "size": "8.4 GB", "sizeleft": "", "timeleft": "", "completed": f"{index} hours ago", "failure": "Missing articles prevented repair" if failed_item else "", "labels": ["INCOMPLETE"] if failed_item else [], "priority": "Normal", "retry_count": 0, "done": True, "failed": failed_item})
        history_total = len(recent)
        recent = recent[:history_limit]
    paused = state == "paused"
    if paused:
        download = [{**jobs["downloading"][0], "status": "Paused"}]
    displayed_active_total = active_total if state == "large" else len(download) + len(verify) + len(unpack)
    free_gb = 12.6 if state == "failed" else 184.2
    return {
        "ok": True, "state": "demo", "web_url": "http://127.0.0.1:8080",
        "queue": {"status": "Paused" if paused else "Downloading", "paused": paused, "speed": "94.7 MB/s", "kbpersec": 96972.8, "timeleft": "0:18:42", "sizeleft": "25.3 GB", "jobs": download},
        "stages": {"download": download, "verify": verify, "unpack": unpack, "recent": recent},
        "disk": {"free_gb": free_gb, "free": f"{free_gb} GB", "low": 0 <= free_gb < disk_threshold_gb},
        "counts": {"download": len(download), "verify": len(verify), "unpack": len(unpack), "recent": len(recent), "failed": sum(1 for item in recent if item["failed"]), "completed": sum(1 for item in recent if not item["failed"]), "active_total": displayed_active_total, "queue_total": active_total if state == "large" else len(download), "history_total": history_total},
    }


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=("snapshot", "pause", "resume", "auth", "retry", "clear_completed", "job_pause", "job_resume"))
    parser.add_argument("--config", default="")
    parser.add_argument("--demo", choices=("downloading", "clean", "processing", "multiple", "paused", "failed", "large", "not-configured", "offline"), default="")
    parser.add_argument("--id", default="")
    parser.add_argument("--queue-limit", type=int, default=100)
    parser.add_argument("--history-limit", type=int, default=50)
    parser.add_argument("--disk-threshold", type=float, default=DEFAULT_DISK_THRESHOLD_GB)
    args = parser.parse_args()
    threshold = disk_threshold(args.disk_threshold)

    try:
        if args.action == "snapshot" and args.demo:
            emit(demo_snapshot(args.demo, max(20, min(args.queue_limit, 1000)), max(20, min(args.history_limit, 1000)), threshold))
        config_path = find_config(args.config)
        base_url, api_key = connection(config_path)
        if args.action == "snapshot":
            emit(snapshot(base_url, api_key, max(20, min(args.queue_limit, 1000)), max(20, min(args.history_limit, 1000)), threshold))
        if args.action == "auth":
            emit({"ok": True, "web_url": base_url})
        if args.action == "retry":
            target_id = job_id(args.id)
            result = api(base_url, api_key, mode="retry", value=target_id)
            action_succeeded = succeeded(result)
            emit({"ok": action_succeeded, "action": "retry", "id": target_id}, 0 if action_succeeded else 6)
        if args.action == "clear_completed":
            result = api(base_url, api_key, mode="history", name="delete", value="completed")
            action_succeeded = succeeded(result)
            emit({"ok": action_succeeded, "action": "clear_completed"}, 0 if action_succeeded else 6)
        if args.action in {"job_pause", "job_resume"}:
            target_id = job_id(args.id)
            name = "pause" if args.action == "job_pause" else "resume"
            result = api(base_url, api_key, mode="queue", name=name, value=target_id)
            action_succeeded = succeeded(result)
            emit({"ok": action_succeeded, "action": args.action, "id": target_id}, 0 if action_succeeded else 6)
        result = api(base_url, api_key, mode=args.action)
        action_succeeded = succeeded(result)
        emit({"ok": action_succeeded, "action": args.action}, 0 if action_succeeded else 6)
    except FileNotFoundError as error:
        emit({"ok": False, "state": "not-configured", "message": text(str(error), limit=512)}, 2)
    except urllib.error.HTTPError as error:
        emit({"ok": False, "state": "api-error", "message": f"SABnzbd API error: HTTP {error.code}"}, 5)
    except (ConnectionError, TimeoutError, urllib.error.URLError):
        emit({"ok": False, "state": "offline", "message": "SABnzbd is not running"}, 3)
    except ApiResponseError as error:
        emit({"ok": False, "state": "api-error", "message": text(str(error), limit=512)}, 5)
    except (configparser.Error, KeyError, ValueError) as error:
        emit({"ok": False, "state": "configuration-error", "message": text(str(error), limit=512)}, 4)


if __name__ == "__main__":
    main()
